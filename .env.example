# --- Site ---
# Canonical production URL (no trailing slash). Used for metadata, sitemap, RSS, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://thematrixisadocumentary.com

# --- Sanity ---
# Create the project at https://sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Optional: read token for previewing drafts / private datasets (server only)
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity publish webhook -> /api/revalidate (on-demand refresh).
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# --- Buy links (book) ---
NEXT_PUBLIC_AMAZON_URL=https://www.amazon.com/dp/B0GT4B3R2S
NEXT_PUBLIC_APPLE_BOOKS_URL=https://books.apple.com/us/book/the-matrix-is-a-documentary/id6761010093
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@DecodeTheReal

# Master switch for the whole video / Decode The Real section (nav item, footer YouTube,
# homepage band, author cross-promo, /videos route, sitemap + JSON-LD + llms.txt).
# Build-time: set to 'true' and redeploy to turn it on. Anything else keeps it off.
NEXT_PUBLIC_SHOW_VIDEOS=false

# --- Email capture (lead magnet: Prologue + Chapter One) ---
# Provider: 'mailerlite' | 'resend' | 'convertkit' | 'none'
# The list platform stores subscribers, sends the download link via its welcome
# automation, and powers newsletters / follow-up sequences.
EMAIL_PROVIDER=mailerlite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Custom-field key in MailerLite that stores each subscriber's download token.
MAILERLITE_TOKEN_FIELD=download_token
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Free sample download ---
# Secret used to sign each subscriber's unique download link (HMAC). NOT shared with
# users. Rotating it invalidates all previously issued links. Generate with:
#   openssl rand -hex 32
DOWNLOAD_LINK_SECRET=

# --- Analytics ---
# Vercel Analytics is enabled automatically on Vercel. Optionally set a Plausible domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
